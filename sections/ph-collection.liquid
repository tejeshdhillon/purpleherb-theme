{%- liquid
  if collection
    assign items = collection.products
    assign heading = collection.title
  else
    assign items = collections.all.products
    assign heading = 'All products'
  endif
-%}
<main>
  <section class="cart-hero"><div class="wrap settle"><p class="label">The collection</p><h1 class="script">{{ heading | downcase }}</h1>
    <p class="lede">Single origin, every one.</p></div></section>
  <div class="wrap" style="display:grid;gap:40px;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));padding-bottom:100px">
    {%- for p in items -%}
      <div class="find settle in" style="position:relative;--x:auto;--y:auto;--w:100%;--r:{% cycle '-2deg','1.5deg','-1deg','2deg' %};left:auto;top:auto;width:auto">
        <a href="{{ p.url }}" aria-label="{{ p.title | escape }}"><div class="find__img">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}</div></a>
        <div class="find__meta"><h3 class="find__name"><a href="{{ p.url }}">{{ p.title }}</a></h3><span class="find__price">{{ p.price | money }}</span></div>
      </div>
    {%- else -%}<p class="lede">Nothing here yet.</p>{%- endfor -%}
  </div>
</main>
{% schema %}
{
  "name": "Collection"
}
{% endschema %}
