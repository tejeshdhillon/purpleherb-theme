<main>
  <!-- HERO — the flower drops and spins onto the mountain (kept from the live theme) -->
  <section class="hero dual-logo" aria-labelledby="hero-title">
    <img class="ghost" src="{{ 'flower.png' | asset_url }}" alt="" style="--gw:1100px;--gy:-260px;--gr:-14deg">
    <i class="el" data-el="petal" data-depth=".6" style="--x:12%;--y:190px;--r:-30deg;--s:.7"></i>
    <i class="el" data-el="leaf" data-depth=".9" style="--x:84%;--y:120px;--r:40deg;--s:.9"></i>
    <i class="el" data-el="thread" data-depth=".4" style="--x:76%;--y:470px;--r:-12deg;--s:.6"></i>
    <i class="el" data-el="berry" data-depth="1.1" style="--x:20%;--y:500px;--s:.35"></i>
    <i class="el" data-el="berry" data-depth="1.1" style="--x:21.6%;--y:518px;--s:.28"></i>
    <i class="el" data-el="stone2" data-depth=".3" style="--x:67%;--y:600px;--r:8deg;--s:.9"></i>
    <p class="label">Nature's rarest superfoods</p>
    <h1 id="hero-title" class="script hero__title">rare by nature</h1>
    <p class="hero__sub"><span>Chosen by nature. Untouched by us.</span> <span>Carried down from the Himalaya exactly as the mountains made it.</span></p>
    <div class="dual-logo-wrapper">
      <div class="dual-logo-upper"><img src="{{ 'flower.png' | asset_url }}" alt="purpleherb flower mark"></div>
      <div class="dual-logo-bottom"><img src="{{ 'base.png' | asset_url }}" alt=""></div>
    </div>
  </section>

  <!-- BELIEF -->
  <section class="section intro" id="story" aria-labelledby="intro-title">
    <i class="el" data-el="leafsilver" data-depth=".8" style="--x:46%;--y:40px;--r:70deg;--s:1.1"></i>
    <i class="el" data-el="stone" data-depth=".2" style="--x:6%;--y:88%;--r:-10deg;--s:.8"></i>
    <div class="wrap">
      <div class="settle">
        <p class="label">Our belief</p>
        <h2 id="intro-title" class="hd hd-l">Where altitude<br>meets ancient<br><span class="it">alchemy.</span></h2>
      </div>
      <div class="intro__text settle" style="--d:.15s">
        <p class="lede">The most potent superfoods grow at elevation, far from industrial farms. We go there, source directly and bring them to you uncompromised.</p>
        <a class="twig" href="#rituals">Walk to the source</a>
      </div>
    </div>
  </section>

  <!-- PROMISE — a dark stone set on the canvas -->
  <section class="section" style="padding-top:0" aria-labelledby="promise-title">
    <i class="el" data-el="crocus" data-depth=".6" style="--x:88%;--y:-30px;--r:16deg;--s:1.3"></i>
    <div class="wrap">
      <div class="stone-card on-dark settle" style="--r:-1.4deg;margin-left:6%;max-width:1000px">
        <img class="ghost" src="{{ 'flower.png' | asset_url }}" alt="" style="--gw:760px;--gx:88%;--gy:-120px;--gr:18deg">
        <p class="label">Our promise</p>
        <h2 id="promise-title" class="hd hd-l">Purity isn’t manufactured.<br>It’s <span class="chip chip--light">preserved.</span></h2>
        <p class="lede" style="margin-top:28px">What reaches you is exactly what Mother Earth made. Nothing more.</p>
      </div>
    </div>
  </section>

  <!-- COLLECTION — set down on the canvas, not in a grid -->
  <section class="section collection" id="collection" aria-labelledby="col-title">
    <div class="wrap">
      <div class="collection__head settle">
        <div>
          <p class="label">The collection</p>
          <h2 id="col-title" class="hd hd-m">Signature superfoods.<br><span class="it">Single origin, every one.</span></h2>
        </div>
        <a class="twig" href="/collections/all">View all products</a>
      </div>
      <div class="field" id="field"></div>
    </div>
  </section>

  <!-- FOUR PROMISES -->
  <section class="section" aria-labelledby="four-title">
    <img class="ghost" src="{{ 'flower.png' | asset_url }}" alt="" style="--gw:900px;--gx:92%;--gy:-80px;--gr:40deg">
    <i class="el" data-el="twig" data-depth=".4" style="--x:6%;--y:60px;--r:-10deg;--s:1.4"></i>
    <div class="wrap">
      <div class="settle" style="max-width:760px">
        <p class="label">What we stand for</p>
        <h2 id="four-title" class="hd hd-l">Four promises,<br>kept at <span class="chip">altitude.</span></h2>
      </div>
      <div class="path-wrap">
        <svg class="path-line" viewBox="0 0 1200 460" preserveAspectRatio="none" aria-hidden="true"><path d="M10 110 C180 40 250 300 380 300 S560 120 650 170 820 380 930 360 1110 200 1190 220"/></svg>
        <div class="steps">
          <div class="step settle"><span class="step__stone"></span><p class="step__sub">Origin</p><h3 class="step__name">Sourced where nature is most potent.</h3><p>Rare regions where altitude, climate and soil make every superfood its most nutrient-dense.</p></div>
          <div class="step settle" style="--d:.12s"><span class="step__stone" style="--r:12deg"></span><p class="step__sub">Untouched</p><h3 class="step__name">Nothing added. Nothing changed.</h3><p>Potency preserved, from origin to your door.</p></div>
          <div class="step settle" style="--d:.24s"><span class="step__stone" style="--r:-20deg"></span><p class="step__sub">Ritual</p><h3 class="step__name">Harvested by hand, at nature’s hour.</h3><p>Centuries-old methods, kept exactly as they were.</p></div>
          <div class="step settle" style="--d:.36s"><span class="step__stone" style="--r:6deg"></span><p class="step__sub">Proven</p><h3 class="step__name">Tested before it’s trusted.</h3><p>Every batch verified by an ISO-certified third-party lab.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ORIGINS — the range, with each source marked -->
  <section class="section" style="padding-bottom:40px" aria-labelledby="org-title">
    <div class="wrap settle">
      <p class="label">Origin</p>
      <h2 id="org-title" class="hd hd-l">Sourced where nature<br>is most <span class="chip">potent.</span></h2>
      <p class="lede" style="margin-top:24px">Rare regions where altitude, climate and soil make every superfood its most nutrient-dense. Touch a flower to visit its valley.</p>
    </div>
    <div class="panorama settle" id="panorama" style="--d:.1s">
      <img src="{{ 'scene-origins.svg' | asset_url }}" alt="Illustrated Himalayan range in layered purples, with the source of each purpleherb harvest marked along it">
    </div>
  </section>

  <!-- RITUALS — scenes from each harvest -->
  <section class="section rituals" id="rituals" aria-labelledby="rit-title">
    <i class="el" data-el="crocus" data-depth=".5" style="--x:88%;--y:120px;--r:12deg;--s:1.2"></i>
    <i class="el" data-el="blossom" data-depth=".7" style="--x:3%;--y:48%;--r:-20deg;--s:1.3"></i>
    <div class="wrap">
      <div class="settle">
        <p class="label">Ritual</p>
        <h2 id="rit-title" class="hd hd-l">Harvested by hand,<br>at nature’s <span class="chip">hour.</span></h2>
        <p class="lede" style="margin-top:24px">Centuries-old methods, kept exactly as they were — by the families who have always known the land.</p>
      </div>
      <div class="rituals__grid" id="rituals-grid"></div>
    </div>
  </section>

  <!-- THE PROOF -->
  <section class="section proof" id="proof" aria-labelledby="proof-title">
    <img class="ghost" src="{{ 'flower.png' | asset_url }}" alt="" style="--gw:820px;--gx:10%;--gy:40px;--gr:-30deg">
    <div class="wrap">
      <div class="settle">
        <p class="label">The proof</p>
        <h2 id="proof-title" class="hd hd-l">Tested where results<br><span class="it">can’t be bought.</span></h2>
        <p class="lede" style="margin-top:26px">Our products go to CFRA at NIFTEM, the Government of India’s food laboratory under the Ministry of Food Processing Industries. An independent report, on every product we sell.</p>
        <p class="lede"><strong style="font-weight:500;color:var(--ph-night)">Ask us for the report before you buy.</strong></p>
        <a class="pebble" href="https://wa.me/919000016479" data-report>Request a lab report</a>
      </div>
      <div class="settle" style="--d:.2s">
        <div class="seal" aria-label="Third-party tested, every batch, ISO-certified lab" role="img">
          <svg class="seal__ring" viewBox="0 0 300 300" aria-hidden="true"><defs><path id="sealPath" d="M150 150 m-122 0 a122 122 0 1 1 244 0 a122 122 0 1 1 -244 0"/></defs><text><textPath href="#sealPath" textLength="750">Third-party tested · Every batch · ISO-certified lab ·</textPath></text></svg>
          <img src="{{ 'flower.png' | asset_url }}" alt="">
        </div>
      </div>
    </div>
  </section>

  <!-- VISION -->
  <section class="section vision" aria-labelledby="vision-title">
    <i class="el" data-el="leaf" data-depth=".6" style="--x:56%;--y:30px;--r:-60deg;--s:.7"></i>
    <div class="wrap">
      <div class="settle">
        <p class="label">Our vision</p>
        <h2 id="vision-title" class="hd hd-l">The real thing,<br>in every<br><span class="it">Indian home.</span></h2>
        <p class="lede" style="margin-top:26px">Single origin. Barely handled. Honestly labelled. Superfoods exactly as the mountains made them.</p>
      </div>
      <div class="stats settle" style="--d:.15s">
        <div class="stat" style="--ty:-20px"><div class="stat__num" data-count="12" data-suffix="+">12<small>+</small></div><p class="stat__label">source regions</p></div>
        <div class="stat" style="--ty:30px"><div class="stat__num" data-count="100" data-suffix="%">100<small>%</small></div><p class="stat__label">traceable ingredients</p></div>
        <div class="stat" style="--ty:-4px"><div class="stat__num" data-count="0" data-suffix="%">0<small>%</small></div><p class="stat__label">additives. Ever.</p></div>
      </div>
    </div>
  </section>

  <!-- COMMITMENT -->
  <section class="section" aria-labelledby="care-title">
    <i class="el" data-el="shard" data-depth=".5" style="--x:8%;--y:70%;--r:-14deg;--s:.9"></i>
    <i class="el" data-el="stone2" data-depth=".3" style="--x:11%;--y:76%;--r:6deg;--s:.6"></i>
    <div class="wrap">
      <div class="stone-card on-dark settle" style="--r:1.2deg;margin-left:auto;max-width:900px">
        <img class="ghost" src="{{ 'flower.png' | asset_url }}" alt="" style="--gw:640px;--gx:10%;--gy:120px;--gr:-24deg">
        <p class="label">Our commitment</p>
        <h2 id="care-title" class="hd hd-l">Care, long before <span class="chip chip--light">cure.</span></h2>
        <p class="lede" style="margin-top:26px">Preventive health, treated with medical-grade seriousness.</p>
        <p class="foot">Lab-tested · Traceable · Zero additives</p>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="section" aria-label="What people say">
    <div class="wrap quote settle">
      <p class="label" style="margin-bottom:24px">What people say</p>
      <blockquote>The Shilajit resin is unlike anything I've tried — clean, potent, and you can actually taste the difference pure sourcing makes.</blockquote>
      <cite class="label">Dr. Arjun Mehta · Ayurvedic Practitioner, Rishikesh</cite>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="section letter" aria-labelledby="nl-title">
    <i class="el" data-el="drop" data-depth=".7" style="--x:80%;--y:20%;--r:8deg;--s:.6"></i>
    <i class="el" data-el="petal" data-depth=".5" style="--x:22%;--y:56%;--r:50deg;--s:.6"></i>
    <div class="wrap settle">
      <h2 id="nl-title" class="script" style="font-size:clamp(48px,6.4vw,82px);margin:0;color:var(--ph-logo)">stay close to the source</h2>
      <p class="lede" style="margin:14px auto 0">Harvest updates from the valleys, new arrivals, and the science behind every ingredient.</p>
      {%- form 'customer', id: 'ph-newsletter' -%}
        {%- if form.posted_successfully? -%}<p class="thanks" role="status">Thank you — you are on the list.</p>{%- endif -%}
        {%- if form.errors -%}<p class="thanks" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="sr-only" for="nl-email">Email address</label>
        <input id="nl-email" type="email" name="contact[email]" placeholder="Your email" required autocomplete="email">
        <button class="pebble" type="submit">Subscribe</button>
      {%- endform -%}
    </div>
  </section>
</main>
{% schema %}
{
  "name": "Homepage"
}
{% endschema %}
