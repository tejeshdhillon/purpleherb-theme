{% layout 'password' %}
<main><section class="cart-hero"><div class="wrap" style="text-align:center">
  <img src="{{ 'flower.png' | asset_url }}" alt="purpleherb" width="90" style="margin:0 auto 20px;display:block">
  <h1 class="script">rare by nature</h1>
  <p class="lede" style="margin:14px auto 28px">{{ shop.password_message | default: 'Opening soon.' }}</p>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <input type="password" name="password" placeholder="Password" style="padding:14px 18px;border-radius:999px;border:1px solid #ddd">
    <button class="pebble" type="submit">Enter</button>
  {%- endform -%}
</div></section></main>
