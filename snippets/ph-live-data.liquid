{%- comment -%}
  Live prices and stock for the five products the design is built around.
  If you change a product's URL handle in Shopify, change it here AND in assets/catalog.js (shopHandle).
{%- endcomment -%}
{%- assign ph_handles = 'kesar,superfood-2,sea-buckthorn-juice,himalayan-shilajit,sea-buckthorn-quad-omega-powder' | split: ',' -%}
<script>
  PH.liveRaw = {
  {%- for h in ph_handles -%}
    {%- assign pr = all_products[h] -%}
    {%- if pr.id -%}
    {{ h | json }}: { available: {{ pr.available | json }}, variants: [
      {%- for v in pr.variants -%}
        { id: {{ v.id }}, title: {{ v.title | json }}, price: {{ v.price | divided_by: 100.0 }}, compare: {{ v.compare_at_price | default: 0 | divided_by: 100.0 }}, available: {{ v.available | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ] },
    {%- endif -%}
  {%- endfor -%}
  };
</script>
